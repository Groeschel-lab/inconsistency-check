# Copy to `.env` (gitignored) for local development, or set as App Service application settings.
# Auth is keyless: `az login` locally, Managed Identity on Azure — no API key needed.

AZURE_AI_ENDPOINT=https://<your-foundry>.services.ai.azure.com
AZURE_AI_DEPLOYMENT=claude-opus-4-7
MODEL_FORMAT=Anthropic
# INSTITUTION_NAME=Sample Hospital
# SYSTEM_PROMPT=            # optional: override the built-in v4_judge prompt
ALLOWED_ORIGINS=*
